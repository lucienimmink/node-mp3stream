{
  "name": "node-mp3stream",
  "description": "simple mp3 streamer",
  "version": "5.11.0",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "main": "app.js",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@peculiar/webcrypto": "^2.0.0",
    "async": "^3.2.6",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "chokidar": "^6.0.0",
    "delete": "^1.1.0",
    "dotenv": "^18.0.10",
    "duration-format": "^0.0.2",
    "fs-walk": "^0.0.2",
    "hono": "^4.13.19",
    "prompts": "^2.4.2",
    "scanner.py": "^2.3.0",
    "sqlite-tag-spawned": "^0.7.1",
    "symlink-or-copy": "^1.3.1",
    "winston": "^3.19.0"
  },
  "scripts": {
    "start": "node app.js",
    "docker:build": "docker build -t jsmusicdb/node-mp3stream:latest .",
    "docker:run": "docker run --mount source=music-share,target=/mnt/music --mount source=jsmusicdb-data,target=/app/public/data -p 16882:16882 jsmusicdb/node-mp3stream:latest",
    "docker:push": "docker push jsmusicdb/node-mp3stream:latest",
    "version": "pnpm run docker:build && pnpm run docker:push",
    "postversion": "git push && git push --tags"
  }
}
